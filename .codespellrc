[codespell]
# The target trees: the root crate's, the detached kernel crate's,
# and the detached proof/fuzz packages' own build trees (the local
# probes create the latter two; their .d dep files ride every build).
skip = ./.git,./target,./ebpf/target,./proofs/target,./fuzz/target,./assets,./Cargo.lock
# hevy is a DELIBERATE misspelling fixture in the supermassive
# self-test typo-rescue pins (NIGHT-improve-19) — the engine must
# suggest --heavy for it, so the word itself has to survive the
# spelling gate. statu is the same class of fixture for the v2 CLI
# depth stresstest (NIGHT-ultimate-3): the case proves the binary's
# subcommand suggestion engine proposes 'status' for the near-miss,
# so the misspelling itself must survive the spelling gate.
# ect is the RFC 3168 ECN codepoint family (ECT(0), ECT(1),
# CE) — the ECN-first lane's vocabulary since NIGHT-private-research-4,
# not a typo of "etc".
# fpr is OpenPGP/GnuPG vocabulary — the fingerprint field token in
# gpg's --with-colons output and the standard short form in the D5
# commit-signature lane (night-solid-defense-2); not a typo of "for".
# iif is the kernel's own input-interface token (skb->iif in the
# cgroup_skb world, the nftables/iproute2 iif match) — the
# night-skill-2 audit quotes the interface-blindness grep
# 'ifindex|iif|oif' verbatim; it is kernel vocabulary, not a typo.
# attachs is the kernel's own bpffs mount option token
# (delegate_attachs, the BPF token delegation API since 6.9 — the
# sibling of delegate_cmds/maps/progs) — the night-frontier-Z15
# kernel-floor watch and the BPF token deferred entry quote the
# four-option family verbatim; it is kernel vocabulary, not a typo.
ignore-words-list = ratatui,uptodate,hevy,statu,ect,iif,fpr,attachs
