[codespell]
skip = ./.git,./target,./ebpf/target,./assets,./Cargo.lock
# hevy is a DELIBERATE misspelling fixture in the supermassive
# self-test typo-rescue pins (NIGHT-improve-19) — the engine must
# suggest --heavy for it, so the word itself has to survive the
# spelling gate. statu is the same class of fixture for the v2 CLI
# depth stresstest (NIGHT-ultimate-3): the case proves the binary's
# subcommand suggestion engine proposes 'status' for the near-miss,
# so the misspelling itself must survive the spelling gate.
ignore-words-list = ratatui,uptodate,hevy,statu
